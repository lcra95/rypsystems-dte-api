# deploy/.env del servidor de producción. Lo crea ./generar-secretos.sh con
# claves aleatorias; queda con permisos 600 y fuera de git.

# --- Acceso -----------------------------------------------------------------
DTE_DOMINIO=dte.ejemplo.cl              # registro DNS A apuntando al servidor
ACME_EMAIL=admin@ejemplo.cl             # avisos de Let's Encrypt
# IP desde las que llama el sistema principal (separadas por espacio).
# Por defecto todas: el token igual es obligatorio.
DTE_IPS_PERMITIDAS=0.0.0.0/0 ::/0
DTE_SERVICE_TOKEN=

# --- Secretos ----------------------------------------------------------------
# Cifra certificados, contraseñas y CAF. GUARDAR UNA COPIA FUERA DEL SERVIDOR:
# si se pierde, los respaldos no sirven para descifrar certificados ni CAF.
DTE_MASTER_KEY=
POSTGRES_PASSWORD=

# --- Avisos al sistema principal -------------------------------------------------
DTE_WEBHOOK_URL=
DTE_WEBHOOK_SECRET=

# --- Tipo de cambio para exportación (Banco Central) -------------------------------
DTE_BCCH_TOKEN=
DTE_BCCH_SERIES=

# --- Respaldos (ver deploy/respaldo/respaldar.sh) ----------------------------------
TZ=America/Santiago
RESPALDO_HORA=3
RESPALDO_DIAS=14
# Clave pública de "age-keygen"; la privada se guarda fuera del servidor.
RESPALDO_AGE_DESTINATARIO=
# Copia fuera del servidor con rclone, p. ej. Backblaze B2:
#   RESPALDO_DESTINO=b2:mi-bucket/dte
#   RCLONE_CONFIG_B2_TYPE=b2
#   RCLONE_CONFIG_B2_ACCOUNT=<keyID>
#   RCLONE_CONFIG_B2_KEY=<applicationKey>
# o S3 / Cloudflare R2 (RCLONE_CONFIG_R2_TYPE=s3, ..._PROVIDER=Cloudflare, ...).
RESPALDO_DESTINO=
# Ping al terminar cada respaldo (p. ej. healthchecks.io): avisa si un día no hay respaldo.
RESPALDO_AVISO_URL=

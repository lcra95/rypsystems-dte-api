# Token que envía el sistema principal: Authorization: Bearer <token>
DTE_SERVICE_TOKEN=
# Clave Fernet para cifrar certificados, contraseñas y CAF:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde, no se pueden descifrar los certificados ni los CAF guardados.
DTE_MASTER_KEY=
# Aviso de cambios de estado al sistema principal (opcional)
DTE_WEBHOOK_URL=
DTE_WEBHOOK_SECRET=
# AGPL sección 13: dónde obtener el código fuente
DTE_CODIGO_FUENTE=
